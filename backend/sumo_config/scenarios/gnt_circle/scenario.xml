<?xml version="1.0" encoding="UTF-8"?>
<!--
  Traffis scenario settings: GNT Circle (SPEC.md §5.2.4 – normative shape).
  Edit values here and reset the simulation (or restart the backend) to apply.
  demand      : vehicles/hour per O-D direction (>= 0, no upper cap; 0 disables).
  behaviour   : global (simulation-level) SUMO vType attributes applied to ALL vehicle types.
  vehicleMix  : shares (must sum to 1.0) + optional per-vtype attribute overrides.
-->
<scenario id="gnt_circle" maxSimTime="300">
    <demand>
        <od key="NG_TL" vehsPerHour="500"/>
        <od key="NG_FL" vehsPerHour="3500"/>
        <od key="TL_FL" vehsPerHour="1000"/>
        <od key="TL_NG" vehsPerHour="500"/>
        <od key="FL_NG" vehsPerHour="3500"/>
        <od key="FL_TL" vehsPerHour="1000"/>
    </demand>

    <behaviour carFollowModel="Krauss" laneChangeModel="SL2015" lateralResolution="0.8">
        <param key="minGap" value="1.0"/>
        <param key="tau" value="0.6"/>
        <param key="sigma" value="0.6"/>
        <param key="impatience" value="0.8"/>
        <param key="speedFactor" value="normc(1.1,0.15,0.7,1.5)"/>
        <param key="lcAssertive" value="2.0"/>
        <param key="lcCooperative" value="0.3"/>
        <param key="lcSpeedGain" value="2.0"/>
        <param key="lcKeepRight" value="0.3"/>
        <param key="latAlignment" value="arbitrary"/>
        <param key="minGapLat" value="0.3"/>
        <param key="jmIgnoreFoeProb" value="0.1"/>
        <param key="jmIgnoreFoeSpeed" value="5.0"/>
        <param key="jmTimegapMinor" value="0.5"/>
    </behaviour>

    <vehicleMix>
        <!-- No motorcycles, trucks or buses in this scenario; shares spread proportionally -->
        <vtype id="auto_rickshaw" share="0.30" minGap="0.8" sigma="0.7"/>
        <vtype id="car" share="0.60"/>
        <vtype id="van" share="0.10"/>
    </vehicleMix>
</scenario>
