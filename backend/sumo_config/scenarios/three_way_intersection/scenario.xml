<?xml version="1.0" encoding="UTF-8"?>
<!--
  Traffis scenario settings: 3-Way T-Intersection.
  Edit values here and reset the simulation (or restart the backend) to apply.
-->
<scenarioSettings>
    <simulation maxSimTime="300"/>

    <traffic defaultSpeedKmh="50" vehiclesPerHour="1500">
        <vehicleMix>
            <vehicle type="car" weight="0.60"/>
            <vehicle type="sports" weight="0.15"/>
            <vehicle type="van" weight="0.15"/>
            <vehicle type="truck" weight="0.10"/>
        </vehicleMix>
        <origins>
            <origin id="west" weight="1"/>
            <origin id="east" weight="1"/>
            <origin id="north" weight="1"/>
        </origins>
    </traffic>

    <!-- Signal groups cycle in document order: each gets green, then amber. -->
    <trafficLight amberDuration="3">
        <signalGroup id="east_west" name="East-West Highway"
                     greenState="GGGrrrGGG" greenDuration="30"
                     amberState="yyyrrryyy" amberDuration="3"/>
        <signalGroup id="north" name="North Approach"
                     greenState="rrrGGGrrr" greenDuration="30"
                     amberState="rrryyyrrr" amberDuration="3"/>
    </trafficLight>
</scenarioSettings>
