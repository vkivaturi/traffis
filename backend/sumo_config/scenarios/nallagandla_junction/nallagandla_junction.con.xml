<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nallagandla Junction – explicit connections.
  Left-hand traffic: lane 0 = kerb side, highest index = median side.
-->
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- tl_fl: TL's kerb lane 0 connects to TL_free_left AND TL_in_b; lane 1 connects to TL_in_b -->
    <connection from="TL_in_a" to="TL_free_left" fromLane="0" toLane="0"/>
    <connection from="TL_in_a" to="TL_in_b"      fromLane="0" toLane="0"/>
    <connection from="TL_in_a" to="TL_in_b"      fromLane="1" toLane="1"/>

    <!-- stem_merge: TL free left joins stem SB kerb lane with pass="true" -->
    <connection from="stem_sb_a"    to="stem_sb_b" fromLane="0" toLane="0"/>
    <connection from="stem_sb_a"    to="stem_sb_b" fromLane="1" toLane="1"/>
    <connection from="stem_sb_a"    to="stem_sb_b" fromLane="2" toLane="2"/>
    <connection from="TL_free_left" to="stem_sb_b" fromLane="0" toLane="0" pass="true"/>

    <!-- stem_S: smooth sweeping turn between stem and bottom road -->
    <connection from="stem_sb_b" to="bot_wb" fromLane="0" toLane="0" speed="13.89"/>
    <connection from="stem_sb_b" to="bot_wb" fromLane="1" toLane="1" speed="13.89"/>
    <connection from="stem_sb_b" to="bot_wb" fromLane="2" toLane="2" speed="13.89"/>

    <connection from="bot_eb" to="stem_nb_a" fromLane="0" toLane="0" speed="13.89"/>
    <connection from="bot_eb" to="stem_nb_a" fromLane="1" toLane="1" speed="13.89"/>
    <connection from="bot_eb" to="stem_nb_a" fromLane="2" toLane="2" speed="13.89"/>

    <!-- fl_stem: lane 0 splits into single-lane FL_free_left AND continues to stem_nb_b; lanes 1,2 continue to stem_nb_b -->
    <connection from="stem_nb_a" to="FL_free_left" fromLane="0" toLane="0" pass="true"/>
    <connection from="stem_nb_a" to="stem_nb_b"   fromLane="0" toLane="0"/>
    <connection from="stem_nb_a" to="stem_nb_b"   fromLane="1" toLane="1"/>
    <connection from="stem_nb_a" to="stem_nb_b"   fromLane="2" toLane="2"/>

    <!-- ng_merge: free left merges into NG_out_b kerb lane alongside through traffic from center -->
    <connection from="NG_out_a"    to="NG_out_b" fromLane="0" toLane="0"/>
    <connection from="NG_out_a"    to="NG_out_b" fromLane="1" toLane="1"/>
    <connection from="FL_free_left" to="NG_out_b" fromLane="0" toLane="0" pass="true"/>

    <!-- Center Junction (Traffic Light Controlled):
         Incoming arms:
           1. NG_in (2 lanes):
              Lane 0: straight to TL_out lane 0
              Lane 1: straight to TL_out lane 1, right turn to stem_sb_a lane 1 & 2
           2. TL_in_b (2 lanes):
              Lane 0: straight to NG_out_a lane 0, left turn to stem_sb_a lane 0
              Lane 1: straight to NG_out_a lane 1
           3. stem_nb_b (3 lanes):
              Lane 0: left turn to NG_out_a lane 0
              Lane 1: right turn to TL_out lane 0
              Lane 2: right turn to TL_out lane 1
    -->
    <!-- From NG_in -->
    <connection from="NG_in" to="TL_out"    fromLane="0" toLane="0"/>
    <connection from="NG_in" to="TL_out"    fromLane="1" toLane="1"/>
    <connection from="NG_in" to="stem_sb_a" fromLane="1" toLane="1"/>
    <connection from="NG_in" to="stem_sb_a" fromLane="1" toLane="2"/>

    <!-- From TL_in_b -->
    <connection from="TL_in_b" to="NG_out_a"  fromLane="0" toLane="0"/>
    <connection from="TL_in_b" to="NG_out_a"  fromLane="1" toLane="1"/>
    <connection from="TL_in_b" to="stem_sb_a" fromLane="0" toLane="0"/>

    <!-- From stem_nb_b -->
    <connection from="stem_nb_b" to="NG_out_a" fromLane="0" toLane="0"/>
    <connection from="stem_nb_b" to="TL_out"    fromLane="1" toLane="0"/>
    <connection from="stem_nb_b" to="TL_out"    fromLane="2" toLane="1"/>
</connections>
