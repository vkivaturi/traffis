<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nallagandla Junction – nodes.
  Origin (0, 0) = 3-way T-junction center (type="traffic_light").
  Left-hand traffic.
  - West Arm: Nallagandla (NG) terminates at NG_end (-160, 0).
  - East Arm: Tellapur (TL) terminates at TL_end (160, 0).
  - South Arm: Stem down to (0, -80), connects to Flyover (FL) bottom road.
  - TL free-left diverges at tl_fl (45, 0) and merges at stem_merge (0, -24).
  - FL free-left diverges at fl_stem (0, -24) and merges at ng_merge (-45, 0).
  - Bottom road connects FL_end (-150, -110) to stem_S (0, -80) directly (no U-turn).
-->
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">
    <!-- Terminals -->
    <node id="NG_end" x="-160.0" y="0.0"    type="dead_end"/>
    <node id="TL_end" x="160.0"  y="0.0"    type="dead_end"/>
    <node id="FL_end" x="-150.0" y="-110.0" type="dead_end"/>

    <!-- Main Signalized Junction (replaces the roundabout) -->
    <node id="center" x="0.0" y="0.0" type="traffic_light"/>

    <!-- TL free left into stem southbound: diverges at tl_fl, merges into stem at stem_merge -->
    <node id="tl_fl"      x="45.0" y="0.0"   type="priority"/>
    <node id="stem_merge" x="0.0"  y="-24.0" type="priority"/>

    <!-- FL free left into NG outbound: diverges from stem northbound at fl_stem, merges at ng_merge -->
    <node id="fl_stem"    x="0.0"   y="-24.0" type="priority"/>
    <node id="ng_merge"   x="-45.0" y="0.0"   type="priority"/>

    <!-- Bottom road: stem_S connects vertical stem with bottom road to FL -->
    <node id="stem_S" x="0.0" y="-80.0" type="priority"/>
</nodes>
