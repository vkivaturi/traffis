<?xml version="1.0" encoding="UTF-8"?>
<!--
  Traffis scenario settings: GNT Circle With Traffic Lights.
  Fixed-time traffic signals active by default at the GNT Circle NG entry (node rb_W).
-->
<scenario id="gnt_circle_with_traffic_lights" maxSimTime="300">
    <demand>
        <od key="NG_TL" vehsPerHour="500"/>
        <od key="NG_FL" vehsPerHour="3000"/>
        <od key="TL_FL" vehsPerHour="1000"/>
        <od key="TL_NG" vehsPerHour="500"/>
        <od key="FL_NG" vehsPerHour="3000"/>
        <od key="FL_TL" vehsPerHour="1000"/>
    </demand>

    <behaviour carFollowModel="Krauss" laneChangeModel="SL2015" lateralResolution="0.8">
        <param key="minGap" value="1.0"/>
        <param key="tau" value="0.6"/>
        <param key="sigma" value="0.6"/>
        <param key="impatience" value="0.8"/>
        <param key="speedFactor" value="normc(1.1,0.15,0.7,1.5)"/>
        <param key="lcAssertive" value="2.0"/>
        <param key="lcCooperative" value="0.3"/>
        <param key="lcSpeedGain" value="2.0"/>
        <param key="lcKeepRight" value="0.3"/>
        <param key="latAlignment" value="arbitrary"/>
        <param key="minGapLat" value="0.3"/>
        <param key="jmIgnoreFoeProb" value="1.0"/>
        <param key="jmIgnoreFoeSpeed" value="10.0"/>
        <param key="jmTimegapMinor" value="0.2"/>
    </behaviour>

    <vehicleMix>
        <!-- No motorcycles, auto rickshaws, trucks or buses in this scenario; shares spread proportionally -->
        <vtype id="car" share="0.85"/>
        <vtype id="van" share="0.15"/>
    </vehicleMix>

    <signals enabled="true" amberDuration="3" allRedDuration="2">
        <group id="NG" name="NG entry (NG→TL, NG→FL)" greenDuration="30"/>
        <group id="FL_TL" name="Ring FL→TL" greenDuration="30"/>
    </signals>
</scenario>
