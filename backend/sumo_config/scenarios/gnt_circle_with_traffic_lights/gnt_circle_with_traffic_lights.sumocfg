<?xml version="1.0" encoding="UTF-8"?>
<!-- GNT Circle With Traffic Lights – SUMO run config. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="gnt_circle_with_traffic_lights.net.xml"/>
        <route-files value="gnt_circle_with_traffic_lights.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="100000"/>
        <step-length value="0.05"/>
    </time>
    <processing>
        <lateral-resolution value="0.8"/>
        <ignore-junction-blocker value="2"/>
        <time-to-teleport value="5"/>
        <time-to-teleport.highways value="5"/>
        <time-to-teleport.highways.min-speed value="0"/>
        <collision.action value="none"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
