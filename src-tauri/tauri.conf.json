{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traffis",
  "version": "0.1.0",
  "identifier": "com.traffis.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Traffis — Traffic Simulation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/run.py": "backend/run.py",
      "../backend/requirements.txt": "backend/requirements.txt",
      "../backend/app": "backend/app",
      "../backend/sumo_config": "backend/sumo_config"
    }
  }
}

